POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_dev_password
DATABASE_URL=postgresql+psycopg://quant:quant_dev_password@localhost:5432/quant

# Source of daily OHLCV bars (produced by quant_daily_bars).
BARS_SCHEMA=market_data
BARS_TABLE=daily_bars

# Which price series to compute indicators against.
INDICATOR_ADJUSTMENT_TYPE=unadjusted

# Recent history (calendar days) loaded per symbol so long-lookback indicators
# (e.g. 200d SMA, 252d support/resistance) warm up before the current value.
INDICATOR_LOOKBACK_DAYS=400

# Compute schedule (seconds). Default: 86400 (24h).
COMPUTE_INTERVAL=86400

# API listener.
API_LISTEN_ADDRESS=0.0.0.0
API_PORT=8001
